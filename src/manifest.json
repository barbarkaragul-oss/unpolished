{
  "manifest_version": 3,
  "name": "__MSG_name__",
  "short_name": "Unpolished",
  "description": "__MSG_desc__",
  "version": "0.0.0",
  "default_locale": "en",
  "minimum_chrome_version": "116",
  "icons": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" },
  "action": { "default_title": "__MSG_name__", "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png" } },
  "side_panel": { "default_path": "panel.html" },
  "options_page": "options.html",
  "background": { "service_worker": "sw.js", "type": "module" },
  "permissions": ["storage", "contextMenus", "activeTab", "scripting", "sidePanel"],
  "optional_host_permissions": ["<all_urls>"],
  "commands": {
    "unpolish": {
      "suggested_key": { "default": "Alt+Shift+U", "mac": "Alt+Shift+U" },
      "description": "__MSG_command__"
    }
  },
  "web_accessible_resources": [
    { "resources": ["panel.html", "panel.js", "panel.css", "fonts/*"], "matches": ["<all_urls>"] }
  ]
}
